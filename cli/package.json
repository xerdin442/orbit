{
  "name": "@xerdin442/orbit-cli",
  "version": "1.0.0-rc.2",
  "description": "CLI for deploying apps on Orbit, a self-hosted PaaS",
  "type": "module",
  "bin": {
    "orbit": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "prepack": "npm run build"
  },
  "keywords": [
    "orbit",
    "paas",
    "deploy",
    "cli",
    "self-hosted"
  ],
  "author": "Mudiakevwe Ovwurhughen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xerdin442/orbit.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/xerdin442/orbit/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/xerdin442/orbit/issues"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "fs-extra": "^11.4.0",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
