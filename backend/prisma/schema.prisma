generator client {
  provider      = "prisma-client"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BuildStatus {
  pending
  cloning
  building
  deploying
  ready
  failed
  aborted
}

enum LifecycleStatus {
  active
  inactive
  aborted
}

enum DeploymentTrigger {
  manual
  webhook
  redeploy
  rollback
}

enum LogLevel {
  INFO
  WARN
  ERROR
  SUCCESS
}

enum ResourceType {
  postgres
  mysql
  redis
  mongo
}

enum ResourceStatus {
  provisioning
  ready
  unhealthy
  failed
}

enum DomainStatus {
  pending
  verifying
  active
  failed
}

enum DomainType {
  managed
  custom
}

enum ActivityType {
  user_signed_up
  user_signed_in
  project_created
  project_updated
  project_deleted
  environment_created
  environment_updated
  environment_deleted
  deployment_started
  deployment_completed
  deployment_failed
  deployment_rolled_back
  deployment_aborted
  variable_created
  variable_updated
  variable_deleted
  domain_added
  domain_removed
  domain_verified
  github_installation_added
  github_installation_removed
  github_webhook_event
  resource_provisioned
  resource_deleted
  resource_data_cleared
  slack_installation_added
  slack_installation_removed
  slack_token_revoked
}

model User {
  id             String   @id @default(uuid())
  githubUserId   Int      @unique
  githubUsername String
  email          String?
  avatarUrl      String?
  createdAt      DateTime @default(now())

  projects            Project[]
  githubInstallations GitHubInstallation[]
  slackInstallation   SlackInstallation?
}

model Project {
  id                 String   @id @default(uuid())
  name               String
  healthCheck        Boolean  @default(false)
  healthCheckPort    Int      @default(3000)
  healthCheckPath    String   @default("/health")
  healthCheckTimeout Int      @default(60)
  buildDirectory     String?
  startCommand       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  source       Source?
  environments Environment[]

  @@index([ownerId])
}

model Source {
  id             String @id @default(uuid())
  repositoryUrl  String
  provider       String
  defaultBranch  String @default("main")
  installationId Int?

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Environment {
  id                  String  @id @default(uuid())
  name                String
  branch              String
  autoDeploy          Boolean @default(false)
  currentDeploymentId String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  deployments Deployment[]
  resources   Resource[]
  variables   EnvironmentVariable[]
  domains     Domain[]
  requestLogs RequestLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model RequestLog {
  id         String   @id @default(uuid())
  timestamp  DateTime @default(now())
  method     String
  uri        String
  statusCode Int
  durationMs Int
  hostname   String

  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
  @@index([environmentId, timestamp])
}

model Deployment {
  id              String            @id @default(uuid())
  commitSha       String
  commitMessage   String?
  imageTag        String?           @unique
  containerId     String?
  trigger         DeploymentTrigger @default(manual)
  buildStatus     BuildStatus       @default(pending)
  lifecycleStatus LifecycleStatus   @default(inactive)
  createdAt       DateTime          @default(now())
  completedAt     DateTime?
  updatedAt       DateTime          @updatedAt

  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  logs DeploymentLog[]

  @@index([environmentId])
}

model DeploymentLog {
  id           String     @id @default(uuid())
  timestamp    DateTime   @default(now())
  level        LogLevel   @default(INFO)
  message      String
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
}

model Resource {
  id          String         @id @default(uuid())
  type        ResourceType
  name        String
  status      ResourceStatus @default(provisioning)
  hostname    String?
  ports       Json?
  credentials Json?
  containerId String?
  volumeId    String?
  networkId   String?

  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([environmentId, name])
  @@index([environmentId])
}

model EnvironmentVariable {
  id        String   @id @default(uuid())
  key       String
  value     String
  generated Boolean  @default(false)
  createdAt DateTime @default(now())

  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([environmentId])
}

model Domain {
  id         String       @id @default(uuid())
  hostname   String       @unique
  type       DomainType   @default(managed)
  status     DomainStatus @default(pending)
  verifiedAt DateTime?

  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([environmentId])
}

model GitHubInstallation {
  id                  String @id @default(uuid())
  installationId      Int
  accountLogin        String
  accountType         String
  repositorySelection Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([installationId])
  @@index([userId])
}

model SlackInstallation {
  id                     String   @id @default(cuid())
  teamId                 String   @unique
  teamName               String?
  enterpriseId           String?
  botUserId              String?
  botId                  String?
  appId                  String?
  scopes                 String[]
  botToken               String
  installerSlackUserId   String
  authorizedSlackUserIds String[]
  raw                    Json
  isEnterpriseInstall    Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
}

model Activity {
  id        String       @id @default(uuid())
  type      ActivityType
  actorId   String
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([actorId])
  @@index([createdAt])
}
