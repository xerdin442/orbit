# ── Node ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=orbit
REDIS_URL=redis://:orbit@localhost:6379

# ── Rate Limiting ────────────────────────────────────
RATE_LIMITING_PER_SECOND=10
RATE_LIMITING_PER_MINUTE=100

# ── GitHub OAuth ─────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ── GitHub App ───────────────────────────────────────
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY=your-private-key
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Docker ───────────────────────────────────────────
DOCKER_SOCKET=//./pipe/docker_engine

# ── Caddy ────────────────────────────────────────────
CADDY_ADMIN_URL=http://localhost:2019
CADDY_CONTAINER_NAME=orbit-caddy

# ── Ingress ──────────────────────────────────────────
INGRESS_HOST=your-domain.sslip.io
INGRESS_IP=0.0.0.0

# ── Resource Images ──────────────────────────────────
POSTGRES_IMAGE_TAG=postgres:16-alpine
MYSQL_IMAGE_TAG=mysql:8.4
REDIS_IMAGE_TAG=redis:7-alpine
MONGO_IMAGE_TAG=mongo:7

# ── Paystack ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_placeholder

# ── Slack ────────────────────────────────────────────
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
SLACK_BOT_SCOPES=app_mentions:read,chat:write,channels:read,commands
