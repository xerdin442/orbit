# ── Node ─────────────────────────────────────────────
NODE_ENV=your-node-env
PORT=your-port

# ── Database ─────────────────────────────────────────
DATABASE_URL=your-database-url

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key

# ── Redis ────────────────────────────────────────────
REDIS_HOST=your-redis-host
REDIS_PORT=your-redis-port
REDIS_PASSWORD=your-redis-password
REDIS_URL=your-redis-url

# ── Rate Limiting ────────────────────────────────────
RATE_LIMITING_PER_SECOND=your-rate-limiting-per-second
RATE_LIMITING_PER_MINUTE=your-rate-limiting-per-minute

# ── Domains ──────────────────────────────────────────
MAX_CUSTOM_DOMAINS=your-max-custom-domains

# ── GitHub OAuth ─────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=your-github-redirect-uri

# ── GitHub App ───────────────────────────────────────
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=your-frontend-url

# ── Docker ───────────────────────────────────────────
DOCKER_SOCKET=your-docker-socket

# ── BuildKit ─────────────────────────────────────────
BUILDKIT_HOST=your-buildkit-host

# ── Caddy ────────────────────────────────────────────
CADDY_ADMIN_URL=your-caddy-admin-url
CADDY_CONTAINER_NAME=your-caddy-container-name
# Caddy calls this URL (from inside its container) to authorize on-demand TLS certs.
# Points at the backend's GET /api/internal/caddy/tls-check endpoint.
CADDY_ON_DEMAND_ASK=http://host.docker.internal:<backend-port>/api/internal/caddy/tls-check
# ACME account contact email, used for both ZeroSSL and the Let's Encrypt fallback.
ACME_EMAIL=your-acme-email
# ZeroSSL API key (dashboard -> Developer -> API Key). Caddy uses it to auto-generate
# EAB credentials. ZeroSSL is the primary issuer; Let's Encrypt is the fallback.
ZEROSSL_API_KEY=your-zerossl-api-key

# ── Ingress ──────────────────────────────────────────
INGRESS_HOST=your-ingress-host
INGRESS_IP=your-ingress-ip

# ── Resource Images ──────────────────────────────────
POSTGRES_IMAGE_TAG=your-postgres-image-tag
MYSQL_IMAGE_TAG=your-mysql-image-tag
REDIS_IMAGE_TAG=your-redis-image-tag
MONGO_IMAGE_TAG=your-mongo-image-tag

# ── Slack ────────────────────────────────────────────
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_REDIRECT_URI=your-slack-redirect-uri
SLACK_BOT_SCOPES=app_mentions:read,chat:write,chat:write.public,channels:read,commands,users:read
SLACK_APP_TOKEN=your-slack-app-token # Use when socket mode is enabled
